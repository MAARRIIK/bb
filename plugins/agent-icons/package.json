{
  "name": "bb-plugin-agent-icons",
  "version": "0.2.1",
  "description": "Give each BB agent provider its own icon and colour: built-in glyphs or your own SVG sets, synced across devices.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "ponomr",
  "repository": {
    "url": "https://github.com/ponomr/bb-plugin-agent-icons.git",
    "type": "git"
  },
  "engines": {
    "bbPluginSdk": ">=0.6.132 <0.7.0",
    "bb": ">=0.49.0 <1.0.0"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "bb": {
    "name": "Agent Icons",
    "description": "Give each BB agent provider its own icon and colour: built-in glyphs or your own SVG sets, synced across devices.",
    "branding": {
      "icon": "./assets/agent-icons.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.3.1"
  }
}
