{
  "appId": "dev.maarriik.ai",
  "productName": "AI",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "toolsets": {
    "appimage": "1.0.3"
  },
  "afterPack": "scripts/prepare-native-modules.cjs",
  "asar": true,
  "asarUnpack": ["dist/bb-app-bridge.mjs", "node_modules/**"],
  "directories": {
    "buildResources": "assets",
    "output": "release"
  },
  "files": [
    "assets/**",
    "dist/**",
    "node_modules/**",
    {
      "from": "node_modules/bb-app/server/dist/app-scaffold-template",
      "to": "node_modules/bb-app/server/dist/app-scaffold-template",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/bb-app/node_modules/npm/node_modules",
      "to": "node_modules/npm/node_modules",
      "filter": ["**/*"]
    },
    "package.json",
    "!**/*.map"
  ],
  "publish": [
    {
      "channel": "latest",
      "provider": "generic",
      "url": "https://github.com/MAARRIIK/bb/releases/download/desktop-latest/"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "AI lets agents you run control other apps on this Mac, such as Computer Use.",
      "NSMicrophoneUsageDescription": "AI uses your microphone for voice input and sites you allow in the in-app browser."
    },
    "minimumSystemVersion": "13.0.0",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "icon": "assets/icon.icns",
    "identity": null,
    "notarize": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ]
  },
  "linux": {
    "category": "Development",
    "executableName": "ai-ide",
    "icon": "assets/icon.png",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "maintainer": "MAARRIIK <90389799+MAARRIIK@users.noreply.github.com>",
    "syncDesktopName": true
  },
  "win": {
    "icon": "assets/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false
  },
  "dmg": {
    "sign": false
  },
  "npmRebuild": false,
  "deb": {
    "packageName": "ai-ide"
  },
  "extraMetadata": {
    "name": "ai-ide",
    "homepage": "https://github.com/MAARRIIK/bb",
    "desktopName": "dev.maarriik.ai.desktop"
  }
}
